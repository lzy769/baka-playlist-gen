{
  "name": "baka-playlist-gen",
  "version": "1.1.0",
  "description": "把任意 Excel / CSV 歌曲列表转换成 BakaMusic 语言分组歌单插件的命令行工具",
  "keywords": [
    "bakamusic",
    "playlist",
    "music",
    "song",
    "excel",
    "csv",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzy769/baka-playlist-gen.git"
  },
  "homepage": "https://github.com/lzy769/baka-playlist-gen#readme",
  "main": "src/cli.mjs",
  "bin": {
    "baka-playlist-gen": "src/cli.mjs"
  },
  "files": [
    "src",
    "templates",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/cli.mjs",
